# Auto-detect text files
* text=auto eol=lf

# Binary files
*.ttf binary
*.woff binary
*.woff2 binary
*.otf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

# Explicit text with LF
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf

# Don't diff dist bundles
dist/*.min.css -diff